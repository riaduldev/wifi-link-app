# ---------------------------------------------------------------------------
# Environment variables (names only — never commit real values or secrets)
# ---------------------------------------------------------------------------

# Public site URL, used for canonical links, Open Graph URLs, sitemap.xml
# and robots.txt. Set this to the real deployment origin before going live.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: HTTPS endpoint that receives the public request forms
# (connection request, coverage check, support ticket, contact message).
# The server action POSTs JSON to this URL.
# Leave it EMPTY to run in "not connected" mode: forms validate, but the UI
# honestly tells the visitor that the request was NOT stored and offers
# phone / WhatsApp / email hand-off instead.
# FORM_ENDPOINT_URL=

# Optional: bearer token sent with the request to FORM_ENDPOINT_URL.
# Server-only — never expose it to the browser.
# FORM_ENDPOINT_TOKEN=
